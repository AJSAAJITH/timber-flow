generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id             String             @id @default(cuid())
  name           String             @unique
  location       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  isBlocked      Boolean            @default(false)
  inventory      BranchInventory[]
  creditPayments CreditPaymentLog[]
  expenses       Expense[]
  inventoryLogs  InventoryLog[]
  sales          Sale[]
  users          User[]             @relation("BranchToUser")
}

model User {
  id             String             @id @default(cuid())
  clerkId        String             @unique
  name           String
  role           Role               @default(CASHIER)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  email          String             @unique
  isBlocked      Boolean            @default(false)
  creditPayments CreditPaymentLog[]
  expenses       Expense[]
  inventoryLogs  InventoryLog[]
  sales          Sale[]
  branches       Branch[]           @relation("BranchToUser")
}

model Category {
  id       String    @id @default(cuid())
  name     String
  products Product[]
}

model Product {
  id            String            @id @default(cuid())
  name          String
  sku           String?           @unique
  categoryId    String
  unitPrice     Decimal           @db.Decimal(10, 2)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  inventory     BranchInventory[]
  inventoryLogs InventoryLog[]
  category      Category          @relation(fields: [categoryId], references: [id])
  saleItems     SaleItem[]
}

model BranchInventory {
  id         String  @id @default(cuid())
  branchId   String
  productId  String
  stockLevel Int     @default(0)
  minStock   Int     @default(10)
  branch     Branch  @relation(fields: [branchId], references: [id])
  product    Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
}

model InventoryLog {
  id        String           @id @default(cuid())
  quantity  Int
  note      String?
  branchId  String
  productId String
  userId    String
  createdAt DateTime         @default(now())
  type      InventoryLogType
  branch    Branch           @relation(fields: [branchId], references: [id])
  product   Product          @relation(fields: [productId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
}

model Customer {
  id             String             @id @default(cuid())
  name           String
  phone          String?
  totalDue       Decimal            @default(0) @db.Decimal(10, 2)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  address        String?
  nic            String?            @unique
  creditPayments CreditPaymentLog[]
  sales          Sale[]
}

model CreditPaymentLog {
  id         String   @id @default(cuid())
  amountPaid Decimal  @db.Decimal(10, 2)
  note       String?
  customerId String
  userId     String
  createdAt  DateTime @default(now())
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([branchId, createdAt])
}

model Sale {
  id            String        @id @default(cuid())
  totalAmount   Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(10, 2)
  dueAmount     Decimal       @default(0) @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PAID)
  branchId      String
  userId        String
  customerId    String?
  createdAt     DateTime      @default(now())
  invoiceNumber String?       @unique
  branch        Branch        @relation(fields: [branchId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  items         SaleItem[]

  @@index([branchId, createdAt])
  @@index([paymentStatus, branchId])
}

model SaleItem {
  id            String  @id @default(cuid())
  saleId        String
  productId     String
  quantity      Int
  priceAtSale   Decimal @db.Decimal(10, 2)
  originalPrice Decimal @db.Decimal(10, 2)
  product       Product @relation(fields: [productId], references: [id])
  sale          Sale    @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model Expense {
  id          String      @id @default(cuid())
  amount      Decimal     @db.Decimal(10, 2)
  description String
  branchId    String
  userId      String
  createdAt   DateTime    @default(now())
  type        ExpenseType @default(GENERAL)
  branch      Branch      @relation(fields: [branchId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@index([branchId, createdAt])
  @@index([createdAt])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  CREDIT
  BANK_TRANSFER
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIALLY_PAID
}

enum InventoryLogType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  DAMAGE
  RETURN
}

enum ExpenseType {
  GENERAL
  PROFIT_WITHDRAWAL
  SALARY
  PETTY_CASH
  BILL_PAYMENT
}
